# Copie ce fichier en .env pour configurer l'interprète des signaux.
# Par défaut (auto), l'app utilise Ollama s'il tourne sur ton ordinateur : rien à configurer.

# auto | ollama | openai | claude | reve
COSMOS_PROVIDER=auto

# Modèle à utiliser (défaut : mistral pour Ollama)
# COSMOS_MODEL=mistral

# --- Ollama (gratuit, open source, local) ---
# OLLAMA_URL=http://localhost:11434

# --- Service compatible OpenAI (ex. Groq, OpenRouter, LM Studio) ---
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# COSMOS_MODEL=llama-3.1-8b-instant

# --- Claude (payant) ---
# ANTHROPIC_API_KEY=

PORT=3000
